# Transcription engine: local (faster-whisper, free, runs on your CPU) or scribe (ElevenLabs, paid)
VIDEO_USE_ASR=local
# Whisper model: tiny | base | small | medium | large-v3 | large-v3-turbo  (bigger = better + slower)
VIDEO_USE_WHISPER_MODEL=small
VIDEO_USE_WHISPER_COMPUTE=int8
# Only needed with VIDEO_USE_ASR=scribe
ELEVENLABS_API_KEY=
